# Groq API kaliti: https://console.groq.com/keys
# Mahalliy ishga tushirish uchun shu faylni .env.local nomi bilan nusxalang.
# Vercel'da: Project → Settings → Environment Variables → GROQ_API_KEY.
# Bir nechta kalit (turli tashkilotlardan) vergul bilan berilsa, limit tugaganda navbatdagisi ishlatiladi.
GROQ_API_KEY=gsk_...

# Ixtiyoriy: modellarni almashtirish (sukut bo'yicha pastdagilar)
# GROQ_MODEL_PRIMARY=qwen/qwen3.8-27b
# GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
# GROQ_MODEL_STT=whisper-large-v3-turbo

# Ixtiyoriy: API'ni faqat shu domenlardan chaqirishga ruxsat (vergul bilan)
# ALLOWED_ORIGINS=https://kafedra-agent.vercel.app
